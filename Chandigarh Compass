        else:
            best = min(plans, key=lambda p: (plans[p]["minutes"], plans[p]["fare"]))
            tk.Label(tab2, text=f"Travelling by {mode.lower()}. Best time to leave: {best}", bg="white", fg="#14806a", font=("Segoe UI", 11, "bold")).pack(anchor="w", pady=(0, 8))
            chart = tk.Canvas(tab2, width=720, height=190, bg="white", highlightthickness=0); chart.pack(anchor="w")
            longest = max(r["minutes"] for r in plans.values())
            for i, (p, r) in enumerate(plans.items()):
                y = 12 + i * 44
                ratio = r["minutes"] / max(r["free"], 1)
                color = LEVEL_COLORS[0 if ratio < 1.15 else 1 if ratio < 1.5 else 2]
                chart.create_text(0, y + 12, text=p, anchor="w", fill="#263a50", font=("Segoe UI", 9, "bold"))
                chart.create_rectangle(170, y, 170 + 400 * r["minutes"] / longest, y + 26, fill=color, outline="")
                chart.create_text(178 + 400 * r["minutes"] / longest, y + 13, text=f"{r['minutes']} min · ₹{r['fare']}", anchor="w", fill="#263a50", font=("Segoe UI", 9))
            for p, r in plans.items():
                extra = r["minutes"] - plans[best]["minutes"]
                tk.Label(tab2, text=f"{p}: {'best choice' if p == best else f'+{extra} min vs best'}", bg="white", fg="#40546a").pack(anchor="w")
            if mode == "Walk":
                tk.Label(tab2, text="Walking time does not change with traffic.", bg="white", fg="#78899b").pack(anchor="w", pady=6)


