# Roads work both ways: add any missing reverse links (fixes unreachable places).
for _a, _links in list(PLACES.items()):
    for _b, _km in _links:
        if not any(n == _a for n, _ in PLACES[_b]):
            PLACES[_b].append((_a, _km))

# Assumed average city speeds in km/h (rough estimates for the demo).
SPEEDS = {"Walk": 5, "Bike": 25, "Auto": 22, "Car": 30}

# Cost assumptions in rupees. These are EDITABLE ESTIMATES: replace with real local rates.
PETROL = 95                      # rupees per litre
MILEAGE = {"Bike": 40, "Car": 15}  # km per litre
AUTO_BASE, AUTO_PER_KM, AUTO_WAIT_PER_MIN = 30, 14, 1.5  # fare, per km, per minute stuck in traffic

# ---- City-wide traffic model (applies to EVERY road) ----
# Busy hubs attract more traffic on all roads touching them. The time of day
# shifts congestion up or down across the whole network. Simulated, not live.
HUBS = {"ISBT Sector 17", "ISBT Sector 43", "Sector 17 Plaza", "Elante Mall",
        "Chandigarh Railway Station", "Chandigarh Airport", "PGIMER", "Capitol Complex"}
PERIOD_SHIFT = {"Morning peak (8-10)": 1, "Midday": 0, "Evening peak (5-8)": 2, "Night": -2}
LEVELS = ["Clear", "Moderate", "Heavy"]
LEVEL_COLORS = ["#2fb26b", "#f0b429", "#e5484d"]
DELAY = [1.0, 1.6, 2.5]  # travel-time multiplier for each level

KM = {(a, b): km for a, links in PLACES.items() for b, km in links}


def build_traffic(period):
    """Give every road a congestion level 0 (clear) to 2 (heavy)."""
    traffic = {}
    for (a, b) in KM:
        key = frozenset((a, b))
        if key not in traffic:
            score = zlib.crc32("|".join(sorted(key)).encode()) % 3
            score += (a in HUBS) + (b in HUBS) + PERIOD_SHIFT[period]
            traffic[key] = 0 if score <= 1 else 1 if score <= 3 else 2
    return traffic


def make_cost(traffic, mode, fastest, closed=frozenset()):
    """Edge cost: distance for 'shortest', minutes (with traffic) for 'fastest'.
    Closed roads cost infinity, so they are never used."""
    speed = SPEEDS[mode]
    def cost(a, b, km):
        key = frozenset((a, b))
        if key in closed:
            return float("inf")
        if not fastest:
            return km
        delay = 1.0 if mode == "Walk" else DELAY[traffic[key]]
        return km / speed * 60 * delay
    return cost


def route_between(start, finish, cost):
    """Dijkstra: cheapest route under the given cost function (None if unreachable)."""
    costs = {place: float("inf") for place in PLACES}
    previous = {}
    costs[start] = 0
    queue = [(0, start)]
    while queue:
        spent, place = heapq.heappop(queue)
        if spent > costs[place]:
            continue
        if place == finish:
            break
        for neighbor, kilometres in PLACES[place]:
            new_cost = spent + cost(place, neighbor, kilometres)
            if new_cost < costs[neighbor]:
                costs[neighbor] = new_cost
                previous[neighbor] = place
                heapq.heappush(queue, (new_cost, neighbor))
    if costs[finish] == float("inf"):
        return None, float("inf")
    path = [finish]
    while path[-1] != start:
        path.append(previous[path[-1]])
    return list(reversed(path)), costs[finish]


def trip_between(start, via, finish, cost):
    """Cheapest route that passes through an optional via stop."""
    if not via:
        return route_between(start, finish, cost)
    p1, c1 = route_between(start, via, cost)
    p2, c2 = route_between(via, finish, cost)
    if p1 is None or p2 is None:
        return None, float("inf")
    return p1 + p2[1:], c1 + c2


def trip_stats(path, traffic, mode):
    """Return (km, minutes with traffic, minutes with empty roads, heavy segments)."""
    km = minutes = free = heavy = 0
    for a, b in zip(path, path[1:]):
        level = traffic[frozenset((a, b))]
        base = KM[(a, b)] / SPEEDS[mode] * 60
        km += KM[(a, b)]
        free += base
        minutes += base * (1.0 if mode == "Walk" else DELAY[level])
        heavy += level == 2 and mode != "Walk"
    return km, round(minutes), round(free), heavy


def trip_cost(path, traffic, mode):
    """Estimated rupees. Fuel use rises in traffic; auto fares add a waiting charge."""
    if mode == "Walk":
        return 0
    fuel = km = wait = 0.0
    for a, b in zip(path, path[1:]):
        d, mult = KM[(a, b)], DELAY[traffic[frozenset((a, b))]]
        km += d
        wait += d / SPEEDS[mode] * 60 * (mult - 1)
        if mode in MILEAGE:
            fuel += d / MILEAGE[mode] * PETROL * (1 + 0.2 * (mult - 1))
    return round(AUTO_BASE + AUTO_PER_KM * km + AUTO_WAIT_PER_MIN * wait) if mode == "Auto" else round(fuel)


def plan_trip(start, via, finish, mode, traffic, closed=frozenset(), fastest=True):
    """One call that returns everything about a trip, or None if no route exists."""
    path, _ = trip_between(start, via, finish, make_cost(traffic, mode, fastest, closed))
    if path is None:
        return None
    km, minutes, free, heavy = trip_stats(path, traffic, mode)
    return {"path": path, "km": km, "minutes": minutes, "free": free, "heavy": heavy,
            "fare": trip_cost(path, traffic, mode)}


def road_points(a, b):
    """The bent line used to draw the road between two places."""
    (x1, y1), (x2, y2) = COORDS[a], COORDS[b]
    bend = (x1 + x2) // 2
    return [(x1, y1), (bend, y1), (bend, y2), (x2, y2)]


def segment_distance(px, py, x1, y1, x2, y2):
    length = (x2 - x1) ** 2 + (y2 - y1) ** 2
    t = 0 if length == 0 else max(0, min(1, ((px - x1) * (x2 - x1) + (py - y1) * (y2 - y1)) / length))
    return ((px - (x1 + t * (x2 - x1))) ** 2 + (py - (y1 + t * (y2 - y1))) ** 2) ** 0.5


def nearest_road(px, py, edges, limit=8):
    """The road (frozenset of two places) closest to a map click, or None."""
    best = None
    for edge in edges:
        pts = road_points(*sorted(edge))
        d = min(segment_distance(px, py, *pts[i], *pts[i + 1]) for i in range(3))
        if d < limit and (best is None or d < best[0]):
            best = (d, edge)
    return best[1] if best else None


COORDS = {"Chandigarh Railway Station":(110,100),"Chandigarh Airport":(110,360),"ISBT Sector 17":(350,210),"ISBT Sector 43":(600,420),"Sector 17 Plaza":(390,260),"Capitol Complex":(570,150),"Rose Garden":(450,160),"Panjab University":(340,100),"PGIMER":(270,140),"Sukhna Lake":(680,100),"Rock Garden":(680,180),"Zakir Hussain Rose Garden":(490,90),"Tagore Theatre":(400,130),"Elante Mall":(250,350),"Industrial Area":(240,250),"Cricket Stadium":(590,320),"Garden of Silence":(740,400),"Japanese Garden":(780,300),"Sector 22 Market":(470,350),"Mansa Devi Temple":(800,180)}


