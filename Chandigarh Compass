    def marker(self, place):
        """Return a short, font-safe map badge and its color."""
        name = place.lower()
        if any(word in name for word in ("entrance", "parking", "station", "isbt", "airport")):
            return "P", "#2878b5"
        if any(word in name for word in ("food", "coffee", "cafe")):
            return "F", "#e28a2b"
        if any(word in name for word in ("cinema", "game", "kids", "play", "theatre", "garden", "lake", "rock")):
            return "A", "#7a55b7"
        if any(word in name for word in ("hospital", "pgimer", "temple", "capitol", "university", "plaza")):
            return "L", "#16806a"
        if any(word in name for word in ("mall", "shop", "street", "store", "book", "jewellery", "market", "supermarket", "area")):
            return "S", "#d25d74"
        return "M", "#62748a"

    def road(self, a, b, color, width, dash=None):
        flat = [c for point in road_points(a, b) for c in point]
        self.map.create_line(*flat, fill=color, width=width, joinstyle="round", dash=dash)

    def draw_map(self, route=None):
        self.map.delete("all")
        self.map.create_text(16, 12, text="CHANDIGARH · schematic sector grid · click any road to close or reopen it", anchor="nw", fill="#8292a5", font=("Segoe UI", 9, "bold"))
        legend = [("#dce5ef", "Roads")] if not self.show_traffic.get() else list(zip(LEVEL_COLORS, LEVELS))
        legend += [("#333333", "Closed"), ("#1d4ed8", "Your route")]
        x = 20
        for color, text in legend:
            self.map.create_line(x, 42, x + 28, 42, fill=color, width=5)
            self.map.create_text(x + 35, 42, text=text, anchor="w", fill="#60748a", font=("Segoe UI", 9))
            x += 105
        for edge, level in self.traffic.items():
            a, b = sorted(edge)
            if edge in self.closed:
                self.road(a, b, "#333333", 4, dash=(5, 4))
            else:
                self.road(a, b, LEVEL_COLORS[level] if self.show_traffic.get() else "#dce5ef", 3)
        if route:
            for a, b in zip(route, route[1:]):
                self.road(a, b, "#1d4ed8", 6)
        for place, (x, y) in COORDS.items():
            badge, badge_color = self.marker(place)
            self.map.create_oval(x-12, y-12, x+12, y+12, fill="#1d4ed8" if route and place in route else badge_color, outline="white", width=2)
            self.map.create_text(x, y, text=badge, fill="white", font=("Segoe UI", 8, "bold"))
            self.map.create_text(x, y-11, text=place, anchor="s", fill="#263a50", font=("Segoe UI", 8, "bold"))

    def click_map(self, event):
        """Clicking a road closes it (an accident or roadwork); clicking again reopens it."""
        if any((event.x - x) ** 2 + (event.y - y) ** 2 < 15 ** 2 for x, y in COORDS.values()):
            return
        edge = nearest_road(event.x, event.y, self.traffic)
        if edge:
            self.closed ^= {edge}
            self.refresh()

    def refresh(self):
        """Time of day, traffic toggle or closures changed: update every road and any open route."""
        self.traffic = self.traffic_all[self.period.get()]
        counts = [sum(1 for e, v in self.traffic.items() if v == i and e not in self.closed) for i in range(3)]
        worst = sorted((e for e, v in self.traffic.items() if v == 2 and e not in self.closed), key=lambda e: -KM.get(tuple(e), 0))[:3]
        worst_text = "\n".join("• " + " – ".join(sorted(e)) for e in worst) or "No heavy roads right now"
        self.summary.config(text=f"{counts[2]} heavy · {counts[1]} moderate · {counts[0]} clear · {len(self.closed)} closed\n\nMost congested:\n{worst_text}")
        if self.route:
            self.find()
        else:
            self.draw_map()

    def read_trip(self):
        start, finish, via = self.start.get(), self.end.get(), self.via.get()
        if start == finish or via in (start, finish):
            self.result.config(text="Choose different places for From, To and Via.")
            return None
        return start, via, finish

    def find(self):
        trip = self.read_trip()
        if not trip:
            return
        start, via, finish = trip
        mode, fastest = self.mode.get(), self.by.get().startswith("Fastest")
        r = plan_trip(start, via, finish, mode, self.traffic, self.closed, fastest)
        if r is None:
            self.route = None
            self.result.config(text="No route available: too many roads are closed. Click a dashed road on the map to reopen it.")
            self.draw_map()
            return
        cost_text = "free" if mode == "Walk" else f"about ₹{r['fare']}"
        lines = [f"{r['minutes']} min · {r['km']} km · {cost_text}", f"by {mode.lower()}, {self.period.get().lower()}"]
        if via:
            lines.append(f"via {via}")
        if r["minutes"] - r["free"] >= 1:
            lines.append(f"Traffic adds about {r['minutes'] - r['free']} min")
        if r["heavy"]:
            lines.append(f"{r['heavy']} heavy-traffic segment(s) on this route")
        if fastest:
            short = plan_trip(start, via, finish, mode, self.traffic, self.closed, False)
            saved = short["minutes"] - r["minutes"]
            if saved >= 1:
                lines.append(f"Saves {saved} min vs the shortest-distance route")
        if mode != "Walk":
            options = {p: plan_trip(start, via, finish, mode, t, self.closed) for p, t in self.traffic_all.items()}
            best = min(options, key=lambda p: options[p]["minutes"])
            gain = r["minutes"] - options[best]["minutes"]
            if gain >= 3:
                lines.append(f"Tip: leaving at '{best}' would save {gain} min")
        self.result.config(text="\n".join(lines) + "\n\n" + " → ".join(path_names(r["path"])))
        self.route = r["path"]
        self.draw_map(r["path"])

